# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=            # free key from https://aistudio.google.com/apikey ; empty = demo mode
GEMINI_MODEL=gemini-3.8-flash
# tried in order if the main model is busy (503/429) or retired (404)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENC_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
VAULT_HMAC_KEY=
RETENTION_MINUTES=1440
PII_THRESHOLD=0.5
# Admin console (Admin tab). If ADMIN_PASSWORD is empty, a random one is printed in the terminal at start-up.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
